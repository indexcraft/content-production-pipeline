# Set ONE of these — the pipeline auto-detects which provider to use.
# If both are set, Anthropic is used by default; override with
# CONTENT_PIPELINE_LLM_PROVIDER=openai if you want OpenAI instead.
#
# Unlike the other tools in this series, this pipeline calls an LLM at
# every stage (research, outline, writing, editing, SEO metadata) — a
# key is required, not optional.

OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: force a specific provider when both keys are set above
# CONTENT_PIPELINE_LLM_PROVIDER=openai
